# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Configuration (Use test credentials for development: rzp_test_...)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Cloudflare R2 Storage (Private Bucket for PDF Storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="backlog-saver-materials"
R2_PUBLIC_DOMAIN=""

# Application & Auth Secrets
JWT_SECRET="backlog_saver_secure_jwt_secret_key_2026"
ADMIN_INITIAL_EMAIL="admin@backlogsaver.in"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword123!"

# Firebase Configuration (Set in Vercel Environment Variables)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="backlog-saver.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://backlog-saver-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="backlog-saver"
VITE_FIREBASE_STORAGE_BUCKET="backlog-saver.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="560406543504"
VITE_FIREBASE_APP_ID="1:560406543504:web:c6b2058b8b996fd4e2ac15"

